# Copy to .env and adjust.
#   - docker compose reads POSTGRES_* and POSTGRES_PORT
#   - the app and scripts (config.Settings) read the RAG_* vars

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag
POSTGRES_PORT=5433

# --- App ---
RAG_DSN=postgresql://postgres:postgres@localhost:5433/rag
RAG_EMBED_MODEL=intfloat/multilingual-e5-small
# Prefixes the model was trained with; E5 needs these, most other models
# take none (leave empty). Keep the quotes so the trailing space survives.
RAG_EMBED_QUERY_PREFIX="query: "
RAG_EMBED_DOCUMENT_PREFIX="passage: "
# Chunk budgets in embedder tokens: stored content, overlap carried from the
# previous chunk, and the [Header > ...] breadcrumb (both embedding-only).
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=40
RAG_CHUNK_BREADCRUMB_TOKENS=64

# Any OpenAI-compatible endpoint
RAG_LLM_BASE_URL=http://localhost:1234/v1
RAG_LLM_API_KEY=lm-studio
RAG_LLM_MODEL=your-model-name
